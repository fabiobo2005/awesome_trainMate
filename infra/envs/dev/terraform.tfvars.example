mysql_admin_password = "REPLACE_WITH_SECURE_PASSWORD"

# Frontend runtime API URL (replace once ingress is defined)
frontend_api_base_url = "https://api.trainmate.local"

# Optional overrides
mysql_database_name = "trainmate"
container_image_tag = "latest"

